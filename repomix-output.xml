  private final TeacherRepository teacherRepository;

  @Transactional
  public CourseTeacher assignTeacher(UUID courseAssignmentId, UUID teacherId) {
    var groupCourse =
        groupCourseRepository
            .findById(courseAssignmentId)
            .orElseThrow(
                () ->
                    new ResponseStatusException(
