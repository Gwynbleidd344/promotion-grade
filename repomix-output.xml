<file path="doc/api.yml">
openapi: 3.0.3
info:
  title: HEI Academic Management API
  description: >
    API for managing HEI students' grades and graduation over a 3-year program
    (PROG4 / SYS3). Covers authentication, account registration and role
    management, students, teachers, courses, groups, promotions, group
    history, course assignments, exams, grades (with history), transcripts,
    and graduation lists.
  version: 1.0.0
servers:
  - url: http://localhost:8080/api/v1

tags:
  - name: Auth
  - name: Accounts
  - name: Students
  - name: Teachers
  - name: Courses
  - name: Groups
  - name: Promotions
  - name: Academic Years
  - name: Group History
  - name: Course Assignments
  - name: Exams
  - name: Grades
  - name: Transcripts
  - name: Graduation

security:
  - bearerAuth: []

paths:
  /auth/login:
    post:
      tags: [Auth]
      summary: Authenticate a user
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/LoginRequest"
      responses:
        "200":
          description: Authentication successful
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LoginResponse"
        "401":
          $ref: "#/components/responses/Unauthorized"

  /auth/register:
    post:
      tags: [Accounts]
      summary: Register a new user account
      description: >
        Creates a new user account (username, email, password). The account
        is created with no business role assigned yet (role = null); an
        admin must subsequently promote it to STD, TEC, or ADM via one of
        PATCH /users/{id}/role/student, PATCH /users/{id}/role/teacher, or
        PATCH /users/{id}/role/admin. Open to unauthenticated callers so
        people can self-register before being assigned a role by an admin.
      security: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/RegisterRequest"
      responses:
        "201":
          description: Account created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserAccount"
        "400":
          $ref: "#/components/responses/BadRequest"
        "409":
          description: Username or email already taken
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"

  /users:
    get:
      tags: [Accounts]
      summary: List user accounts
      parameters:
        - $ref: "#/components/parameters/RoleFilter"
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/Size"
      responses:
        "200":
          description: List of user accounts
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/UserAccount"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

  /users/{id}:
    get:
      tags: [Accounts]
      summary: Get a user account by id
      parameters:
        - $ref: "#/components/parameters/UserId"
      responses:
        "200":
          description: User account found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserAccount"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /users/{id}/role/student:
    patch:
      tags: [Accounts]
      summary: Promote a user account to STD
      description: >
        Creates the Student profile (studentNumber generated server-side)
        and assigns an initial promotion and group in the same call. Creates
        the first StudentGroupHistory entry. groupId must already be linked
        to promotionId (see POST /promotions/{id}/groups/{groupId}).
        Admin-only.
      parameters:
        - $ref: "#/components/parameters/UserId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PromoteStudentRequest"
      responses:
        "200":
          description: Role updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserAccount"
        "400":
          description: >
            Invalid request, e.g. unknown program/promotion, or groupId not
            linked to promotionId
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /users/{id}/role/teacher:
    patch:
      tags: [Accounts]
      summary: Promote a user account to TEC
      description: >
        Creates the Teacher profile (employeeNumber generated server-side).
        Admin-only.
      parameters:
        - $ref: "#/components/parameters/UserId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PromoteTeacherRequest"
      responses:
        "200":
          description: Role updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserAccount"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /users/{id}/role/admin:
    patch:
      tags: [Accounts]
      summary: Promote a user account to ADM
      description: >
        Creates the Admin profile (adminNumber generated server-side).
        Admin-only.
      parameters:
        - $ref: "#/components/parameters/UserId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PromoteAdminRequest"
      responses:
        "200":
          description: Role updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserAccount"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students:
    get:
      tags: [Students]
      summary: List students
      parameters:
        - $ref: "#/components/parameters/PromotionId"
        - $ref: "#/components/parameters/ProgramCode"
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/Size"
      responses:
        "200":
          description: List of students
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Student"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

  /students/{id}:
    get:
      tags: [Students]
      summary: Get a student by id
      parameters:
        - $ref: "#/components/parameters/StudentId"
      responses:
        "200":
          description: Student found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Student"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students/{id}/promotion-and-group:
    patch:
      tags: [Group History]
      summary: Change a student's promotion and group together
      description: >
        For later use (e.g. redoing a year, moving groups mid-program).
        groupId must already be linked to promotionId. Appends a new
        StudentGroupHistory entry and closes the previous open entry
        (sets its endDate to the new entry's startDate). Never deletes
        previous entries.
      parameters:
        - $ref: "#/components/parameters/StudentId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/StudentPromotionAndGroupChangeRequest"
      responses:
        "200":
          description: Student updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Student"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students/{id}/group:
    patch:
      tags: [Group History]
      summary: Change a student's group only
      description: >
        The target group must belong to the student's current promotion;
        rejected otherwise. Appends a new StudentGroupHistory entry and
        closes the previous open entry (sets its endDate to the new entry's
        startDate). Never deletes previous entries.
      parameters:
        - $ref: "#/components/parameters/StudentId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/StudentGroupChangeRequest"
      responses:
        "200":
          description: Student updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Student"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students/{id}/group-history:
    get:
      tags: [Group History]
      summary: View a student's group history
      parameters:
        - $ref: "#/components/parameters/StudentId"
        - $ref: "#/components/parameters/AcademicYearId"
      responses:
        "200":
          description: Student's group history, ordered by start date
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/StudentGroupHistory"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /teachers:
    get:
      tags: [Teachers]
      summary: List teachers
      parameters:
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/Size"
      responses:
        "200":
          description: List of teachers
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Teacher"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

  /courses:
    get:
      tags: [Courses]
      summary: List courses
      parameters:
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/Size"
      responses:
        "200":
          description: List of courses
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Course"
        "401":
          $ref: "#/components/responses/Unauthorized"
    post:
      tags: [Courses]
      summary: Create a course
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CourseCreateRequest"
      responses:
        "201":
          description: Course created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Course"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

  /groups:
    get:
      tags: [Groups]
      summary: List groups
      parameters:
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/Size"
      responses:
        "200":
          description: List of groups
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/StudentGroup"
        "401":
          $ref: "#/components/responses/Unauthorized"
    post:
      tags: [Groups]
      summary: Create a group
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/StudentGroupCreateRequest"
      responses:
        "201":
          description: Group created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StudentGroup"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

  /promotions:
    get:
      tags: [Promotions]
      summary: List promotions
      parameters:
        - $ref: "#/components/parameters/Page"
        - $ref: "#/components/parameters/Size"
      responses:
        "200":
          description: List of promotions, sorted by graduation year descending
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Promotion"
        "401":
          $ref: "#/components/responses/Unauthorized"
    post:
      tags: [Promotions]
      summary: Create a promotion
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PromotionCreateRequest"
      responses:
        "201":
          description: Promotion created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Promotion"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

  /promotions/{id}/groups/{groupId}:
    post:
      tags: [Promotions]
      summary: Link a group to a promotion
      description: >
        Declares that this group is a valid group for this promotion. This
        link is the source of truth used to validate groupId on student
        creation, on PATCH /students/{id}/promotion-and-group, and on
        PATCH /students/{id}/group.
      parameters:
        - $ref: "#/components/parameters/PromotionIdPath"
        - $ref: "#/components/parameters/GroupIdPath"
      responses:
        "201":
          description: Group linked to promotion
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
