  /course-assignments:
    get:
      tags: [Course Assignments]
      summary: List course/group/year assignments (GroupCourse)
      parameters:
        - $ref: "#/components/parameters/GroupId"
        - $ref: "#/components/parameters/CourseId"
        - $ref: "#/components/parameters/AcademicYearId"
        - $ref: "#/components/parameters/Semester"
      responses:
