            schema:
              $ref: "#/components/schemas/CourseAssignmentCreateRequest"
      responses:
        "201":
          description: Assignment created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CourseAssignment"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          description: This group/course/year/semester combination already exists
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"

  /course-assignments/{id}/teachers/{teacherId}:
    post:
      tags: [Course Assignments]
      summary: Assign a teacher to a course assignment (CourseTeacher)
      description: A course can be taught by several teachers.
      parameters:
        - $ref: "#/components/parameters/CourseAssignmentId"
        - $ref: "#/components/parameters/TeacherId"
      responses:
        "201":
          description: Teacher assigned to the course
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/CourseTeacher"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          description: The teacher is already assigned to this course
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"

  /course-assignments/{id}/exams:
    post:
      tags: [Exams]
      summary: Create an exam for a course assignment
      parameters:
        - $ref: "#/components/parameters/CourseAssignmentId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ExamCreateRequest"
      responses:
        "201":
          description: Exam created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Exam"
        "400":
          description: >
            Invalid request, e.g. if the sum of the course's exam
            coefficients would exceed 1
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
    get:
      tags: [Exams]
      summary: List the exams of a course assignment
      parameters:
        - $ref: "#/components/parameters/CourseAssignmentId"
      responses:
        "200":
          description: List of exams
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Exam"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "404":
          $ref: "#/components/responses/NotFound"

  /exams/{id}/grades:
    post:
      tags: [Grades]
      summary: Enter a student's grade for an exam
      description: >
        Restricted to a teacher assigned to the relevant course (or an
        admin). Enforced via Spring Security.
      parameters:
        - $ref: "#/components/parameters/ExamId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/GradeCreateRequest"
      responses:
        "201":
          description: Grade created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Grade"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          description: The teacher does not teach this course
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          description: A grade already exists for this student on this exam
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"

  /grades/{id}:
    put:
      tags: [Grades]
      summary: Update an existing grade
      description: >
        Automatically records the previous value in the grade history
        (old value, new value, change date, and author). Previous history
        entries are never deleted. Restricted to the course's teacher or an
        admin.
      parameters:
        - $ref: "#/components/parameters/GradeId"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/GradeUpdateRequest"
      responses:
        "200":
          description: Grade updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Grade"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students/{id}/grades:
    get:
      tags: [Grades]
      summary: View a student's grades
      parameters:
        - $ref: "#/components/parameters/StudentId"
        - $ref: "#/components/parameters/CourseId"
        - $ref: "#/components/parameters/AcademicYearId"
      responses:
        "200":
          description: List of the student's grades
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Grade"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /grades/{id}/history:
    get:
      tags: [Grades]
      summary: View a grade's change history
      parameters:
        - $ref: "#/components/parameters/GradeId"
      responses:
        "200":
          description: Change history, most recent first
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/GradeHistory"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students/{id}/transcripts:
    get:
      tags: [Transcripts]
      summary: List a student's annual transcripts
      parameters:
        - $ref: "#/components/parameters/StudentId"
      responses:
        "200":
          description: List of transcripts (provisional and complete)
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/AcademicReport"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students/{id}/transcripts/{year}/generate:
    post:
      tags: [Transcripts]
      summary: Generate a student's transcript for an academic year
      description: >
        Computes the general average and credits obtained from the
        available grades, only considers courses belonging to the
        student's program, generates a PDF stored on S3, and marks the
        transcript as provisional or complete depending on whether all
        grades are available.
      parameters:
        - $ref: "#/components/parameters/StudentId"
        - $ref: "#/components/parameters/AcademicYearPathParam"
      responses:
        "201":
          description: Transcript generated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AcademicReport"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /students/{id}/transcripts/{year}/send:
    post:
      tags: [Transcripts]
      summary: Email the transcript to the student
      description: (Potentially asynchronous) sending of the S3-stored PDF by email.
      parameters:
        - $ref: "#/components/parameters/StudentId"
        - $ref: "#/components/parameters/AcademicYearPathParam"
      responses:
        "202":
          description: Transcript send accepted (processed asynchronously)
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          description: Student or transcript not found for this year
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"

  /students/{id}/graduation:
    get:
      tags: [Graduation]
      summary: View a student's graduation status
      description: >
        Graduated if the average is >= 10/20 in every course of their
        program across the 3 years, accounting for group changes and grade
        revisions.
      parameters:
        - $ref: "#/components/parameters/StudentId"
      responses:
        "200":
          description: Graduation status
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/GraduationStatus"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /promotions/{id}/graduates:
    get:
      tags: [Graduation]
      summary: List a promotion's graduates
      description: List sorted by rank, containing rank, student number, last name, first name, and general average.
      parameters:
        - $ref: "#/components/parameters/PromotionIdPath"
        - $ref: "#/components/parameters/ProgramCode"
      responses:
        "200":
          description: List of the promotion's graduates
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/GraduationListEntry"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /promotions/{id}/graduates/export:
    get:
      tags: [Graduation]
      summary: Generate and retrieve the graduates list as XLSX
      description: >
        Generates the graduates list XLSX file, stores it on S3, and
        returns a download URL (not emailed).
      parameters:
        - $ref: "#/components/parameters/PromotionIdPath"
      responses:
        "200":
          description: Export generated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/GraduationListExport"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  parameters:
    UserId:
      name: id
      in: path
      required: true
      description: User account identifier
      schema:
        type: string
        format: uuid
    RoleFilter:
      name: role
      in: query
      required: false
      schema:
        $ref: "#/components/schemas/UserRole"
    StudentId:
      name: id
      in: path
      required: true
      description: Student identifier
      schema:
        type: string
        format: uuid
    TeacherId:
      name: teacherId
      in: path
      required: true
      description: Teacher identifier
      schema:
        type: string
        format: uuid
    CourseId:
      name: courseId
      in: query
      required: false
      schema:
        type: string
        format: uuid
    GroupId:
      name: groupId
      in: query
      required: false
      schema:
        type: string
        format: uuid
    GroupIdPath:
      name: groupId
      in: path
      required: true
      description: Group identifier
      schema:
        type: string
        format: uuid
    AcademicYearId:
      name: academicYearId
      in: query
      required: false
      schema:
        type: string
        format: uuid
    AcademicYearPathParam:
      name: year
      in: path
      required: true
      description: Academic year label, e.g. "2025-2026"
      schema:
        type: string
    Semester:
      name: semester
      in: query
      required: false
      schema:
        type: integer
        enum: [1, 2]
    PromotionId:
      name: promotionId
      in: query
      required: false
      schema:
        type: string
        format: uuid
    PromotionIdPath:
      name: id
      in: path
      required: true
      description: Promotion identifier
      schema:
        type: string
        format: uuid
    ProgramCode:
      name: programCode
      in: query
      required: false
      schema:
        $ref: "#/components/schemas/ProgramCode"
    CourseAssignmentId:
      name: id
      in: path
      required: true
      description: Course assignment identifier (GroupCourse)
      schema:
        type: string
        format: uuid
    ExamId:
      name: id
      in: path
      required: true
      description: Exam identifier
      schema:
        type: string
        format: uuid
    GradeId:
      name: id
      in: path
      required: true
      description: Grade identifier
      schema:
        type: string
        format: uuid
    Page:
      name: page
      in: query
      required: false
      schema:
        type: integer
        minimum: 0
        default: 0
    Size:
      name: size
      in: query
      required: false
      schema:
        type: integer
        minimum: 1
        default: 20

  responses:
    BadRequest:
      description: Invalid request
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
    Unauthorized:
      description: Authentication required or invalid
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
    Forbidden:
      description: Insufficient rights for this operation
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
    NotFound:
      description: Resource not found
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"

  schemas:
    Error:
      type: object
      properties:
        status:
          type: integer
        message:
          type: string
        timestamp:
          type: string
          format: date-time

    UserRole:
      type: string
      enum: [STD, TEC, ADM]

    ProgramCode:
      type: string
      enum: [EL, TN]

    ReportStatus:
      type: string
      enum: [PROVISIONAL, COMPLETE]

    LoginRequest:
      type: object
      required: [username, password]
      properties:
        username:
          type: string
        password:
          type: string
          format: password

    LoginResponse:
      type: object
      properties:
        accessToken:
          type: string
        tokenType:
          type: string
          example: Bearer
        role:
          $ref: "#/components/schemas/UserRole"
        expiresIn:
          type: integer
          description: Token validity duration in seconds

    RegisterRequest:
      type: object
      required: [username, email, password]
      properties:
        username:
          type: string
        email:
          type: string
          format: email
        password:
          type: string
          format: password
          minLength: 8

    UserAccount:
      type: object
      properties:
        id:
          type: string
          format: uuid
        username:
          type: string
        email:
          type: string
          format: email
        role:
          $ref: "#/components/schemas/UserRole"
        enabled:
          type: boolean
        createdAt:
          type: string
          format: date-time

    PromoteStudentRequest:
      type: object
      required:
        [firstName, lastName, program, promotionId, groupId, academicYearId, semester, startDate]
      properties:
        firstName:
          type: string
        lastName:
          type: string
        program:
          $ref: "#/components/schemas/ProgramCode"
        promotionId:
          type: string
          format: uuid
        groupId:
          type: string
          format: uuid
        academicYearId:
          type: string
          format: uuid
        semester:
          type: integer
          enum: [1, 2]
        startDate:
          type: string
          format: date

    PromoteTeacherRequest:
      type: object
      required: [firstName, lastName]
      properties:
        firstName:
          type: string
        lastName:
          type: string

    PromoteAdminRequest:
      type: object
      required: [firstName, lastName]
      properties:
        firstName:
          type: string
        lastName:
          type: string

    StudentPromotionAndGroupChangeRequest:
      type: object
      required: [promotionId, groupId, academicYearId, semester, startDate]
      properties:
        promotionId:
          type: string
          format: uuid
        groupId:
          type: string
          format: uuid
        academicYearId:
          type: string
          format: uuid
        semester:
          type: integer
          enum: [1, 2]
        startDate:
          type: string
          format: date

    StudentGroupChangeRequest:
      type: object
      required: [groupId, academicYearId, semester, startDate]
      properties:
        groupId:
          type: string
          format: uuid
        academicYearId:
          type: string
          format: uuid
        semester:
          type: integer
          enum: [1, 2]
        startDate:
          type: string
          format: date

    Student:
      type: object
      properties:
        id:
          type: string
          format: uuid
        studentNumber:
          type: string
          example: STD001
        firstName:
          type: string
        lastName:
          type: string
        program:
          $ref: "#/components/schemas/ProgramCode"
        promotionId:
          type: string
          format: uuid
        userAccountId:
          type: string
          format: uuid

    Teacher:
      type: object
      properties:
        id:
          type: string
          format: uuid
        employeeNumber:
          type: string
        firstName:
          type: string
        lastName:
          type: string
        userAccountId:
          type: string
          format: uuid

    Course:
      type: object
      properties:
        id:
          type: string
          format: uuid
        reference:
          type: string
          example: PROG4
        title:
          type: string
        credits:
          type: integer

    CourseCreateRequest:
      type: object
      required: [reference, title, credits]
      properties:
        reference:
          type: string
        title:
          type: string
        credits:
          type: integer
          minimum: 1

    StudentGroup:
      type: object
      properties:
        id:
          type: string
          format: uuid
        reference:
          type: string
          example: K1
        name:
          type: string

    StudentGroupCreateRequest:
      type: object
      required: [reference]
      properties:
        reference:
          type: string
        name:
          type: string

    Promotion:
      type: object
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        graduationYear:
          type: integer

    PromotionCreateRequest:
      type: object
      required: [name, graduationYear]
      properties:
        name:
          type: string
        graduationYear:
          type: integer

    AcademicYear:
      type: object
      properties:
        id:
          type: string
          format: uuid
        label:
          type: string
          example: "2025-2026"
        startDate:
          type: string
          format: date
        endDate:
          type: string
          format: date

    AcademicYearCreateRequest:
      type: object
      required: [label, startDate, endDate]
      properties:
        label:
          type: string
          example: "2025-2026"
        startDate:
          type: string
          format: date
        endDate:
          type: string
          format: date

    StudentGroupHistory:
      type: object
      properties:
        id:
          type: string
          format: uuid
        studentId:
          type: string
          format: uuid
        groupId:
          type: string
          format: uuid
        academicYearId:
          type: string
          format: uuid
        semester:
          type: integer
          enum: [1, 2]
        startDate:
          type: string
          format: date
        endDate:
          type: string
          format: date
          nullable: true

    CourseAssignment:
      type: object
      description: Course/group/year/semester association (GroupCourse)
      properties:
        id:
          type: string
          format: uuid
        groupId:
          type: string
          format: uuid
        courseId:
          type: string
          format: uuid
        academicYearId:
          type: string
          format: uuid
        semester:
          type: integer
          enum: [1, 2]
        teachers:
          type: array
          items:
            $ref: "#/components/schemas/Teacher"

    CourseAssignmentCreateRequest:
      type: object
      required: [groupId, courseId, academicYearId, semester]
      properties:
        groupId:
          type: string
          format: uuid
        courseId:
          type: string
          format: uuid
        academicYearId:
          type: string
          format: uuid
        semester:
          type: integer
          enum: [1, 2]

    CourseTeacher:
      type: object
      properties:
        id:
          type: string
          format: uuid
        teacherId:
          type: string
          format: uuid
        courseAssignmentId:
          type: string
          format: uuid

    Exam:
      type: object
      properties:
        id:
          type: string
          format: uuid
        courseAssignmentId:
          type: string
          format: uuid
        name:
          type: string
        examDate:
          type: string
          format: date
        examTime:
          type: string
          format: time
        coefficient:
          type: number
          format: double
          minimum: 0
          maximum: 1
          description: >
            The sum of all exam coefficients for a given course
            (courseAssignment) must equal 1.

    ExamCreateRequest:
      type: object
      required: [name, coefficient]
      properties:
        name:
          type: string
        examDate:
          type: string
          format: date
        examTime:
          type: string
          format: time
        coefficient:
          type: number
          format: double
          minimum: 0
          maximum: 1

    Grade:
      type: object
      properties:
        id:
          type: string
          format: uuid
        studentId:
          type: string
          format: uuid
        examId:
          type: string
          format: uuid
        value:
          type: number
          format: double
          minimum: 0
          maximum: 20
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    GradeCreateRequest:
      type: object
      required: [studentId, value]
      properties:
        studentId:
          type: string
          format: uuid
        value:
          type: number
          format: double
          minimum: 0
          maximum: 20

    GradeUpdateRequest:
      type: object
      required: [value]
      properties:
        value:
          type: number
          format: double
          minimum: 0
          maximum: 20
        reason:
          type: string
          description: Reason for the change (e.g. student complaint)

    GradeHistory:
      type: object
      properties:
        id:
          type: string
          format: uuid
        gradeId:
          type: string
          format: uuid
        oldValue:
          type: number
          format: double
          nullable: true
        newValue:
          type: number
          format: double
        changedAt:
          type: string
          format: date-time
        changedByUserAccountId:
          type: string
          format: uuid
          nullable: true
        reason:
          type: string
          nullable: true

    AcademicReport:
      type: object
      properties:
        id:
          type: string
          format: uuid
        studentId:
          type: string
          format: uuid
        academicYearId:
          type: string
          format: uuid
        status:
          $ref: "#/components/schemas/ReportStatus"
        pdfS3Key:
          type: string
          nullable: true
        generatedAt:
          type: string
          format: date-time
          nullable: true
        sentAt:
          type: string
          format: date-time
          nullable: true
        generalAverage:
          type: number
          format: double
          nullable: true
        totalCreditsObtained:
          type: integer
          nullable: true

    GraduationStatus:
      type: object
      properties:
        studentId:
          type: string
          format: uuid
        graduated:
          type: boolean
        generalAverage:
          type: number
          format: double
        totalCreditsObtained:
          type: integer
        failedCourses:
          type: array
          description: Courses in the student's program with an average < 10/20, if any
          items:
            type: object
            properties:
              courseId:
                type: string
                format: uuid
              courseReference:
                type: string
              average:
                type: number
                format: double

    GraduationListEntry:
      type: object
      properties:
        rank:
          type: integer
        studentNumber:
          type: string
        lastName:
          type: string
        firstName:
          type: string
        generalAverage:
          type: number
          format: double

    GraduationListExport:
      type: object
      properties:
        promotionId:
          type: string
          format: uuid
        s3Key:
          type: string
        downloadUrl:
          type: string
          format: uri
        generatedAt:
          type: string
          format: date-time
</file>

<file path="src/main/java/api/poja/app/endpoint/event/EventProducer.java">
package api.poja.app.endpoint.event;

import api.poja.app.PojaGenerated;
import api.poja.app.datastructure.ListGrouper;
import api.poja.app.endpoint.event.model.PojaEvent;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import java.util.ArrayList;
import java.util.Collection;
import java.util.List;
import java.util.function.Consumer;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.stereotype.Component;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.eventbridge.EventBridgeClient;
import software.amazon.awssdk.services.eventbridge.model.PutEventsRequest;
import software.amazon.awssdk.services.eventbridge.model.PutEventsRequestEntry;
import software.amazon.awssdk.services.eventbridge.model.PutEventsResponse;
import software.amazon.awssdk.services.eventbridge.model.PutEventsResultEntry;

@PojaGenerated
@Component
@Slf4j
public class EventProducer<T extends PojaEvent> implements Consumer<Collection<T>> {
  private final ObjectMapper om;
  private final EventBridgeClient eventBridgeClient;
  private final String eventBusName;

  private static final int MAX_EVENTS_FOR_PUT_REQUEST = 10;
  private final ListGrouper<T> listGrouper;

  public EventProducer(
      ObjectMapper om,
      EventBridgeClient eventBridgeClient,
      @Value("${aws.eventBridge.bus}") String eventBusName,
      ListGrouper<T> listGrouper) {
    this.om = om;
    this.eventBridgeClient = eventBridgeClient;
    this.listGrouper = listGrouper;
    this.eventBusName = eventBusName;
  }

  @Override
  public void accept(Collection<T> events) {
    for (var batch : listGrouper.apply(events.stream().toList(), MAX_EVENTS_FOR_PUT_REQUEST)) {
      log.info("Events to send: {}", batch);
      PutEventsResponse response = sendRequest(batch);
      checkResponse(response);
    }
  }

  private PutEventsRequest toEventsRequest(List<T> events) {
    return PutEventsRequest.builder()
        .entries(events.stream().map(this::toRequestEntry).toList())
        .build();
  }

  private PutEventsRequestEntry toRequestEntry(PojaEvent event) {
    try {
      String eventAsString = om.writeValueAsString(event);
      return PutEventsRequestEntry.builder()
          .source(event.getEventSource())
          .detailType(event.getClass().getTypeName())
          .detail(eventAsString)
          .eventBusName(this.eventBusName)
          .build();
    } catch (JsonProcessingException e) {
      throw new RuntimeException(e);
    }
  }

  private PutEventsResponse sendRequest(List<T> events) {
    checkPayload(events);
    PutEventsRequest eventsRequest = toEventsRequest(events);
    return eventBridgeClient.putEvents(eventsRequest);
  }

  private boolean isPayloadValid(List<T> events) {
    PutEventsRequest eventsRequest = toEventsRequest(events);
    return eventsRequest.entries().size() <= Conf.MAX_PUT_EVENT_ENTRIES;
  }

  private void checkPayload(List<T> events) {
    if (!isPayloadValid(events)) {
      throw new RuntimeException("Request entries must be <= " + Conf.MAX_PUT_EVENT_ENTRIES);
    }
  }

  private void checkResponse(PutEventsResponse response) {
    List<PutEventsResultEntry> failedEntries = new ArrayList<>();
    List<PutEventsResultEntry> successfulEntries = new ArrayList<>();

    for (PutEventsResultEntry resultEntry : response.entries()) {
      if (resultEntry.eventId() == null) {
        failedEntries.add(resultEntry);
      }
      successfulEntries.add(resultEntry);
    }

    if (!failedEntries.isEmpty()) {
      log.error("Following events were not successfully sent: {}", failedEntries);
    }
    if (!successfulEntries.isEmpty()) {
      log.info("Following events were successfully sent: {}", successfulEntries);
    }
  }

  @Configuration
  public static class Conf {
    public static final int MAX_PUT_EVENT_ENTRIES = 10;
    private final Region region;

    public Conf(@Value("eu-west-3") String region) {
      this.region = Region.of(region);
    }

    @Bean
    public EventBridgeClient getEventBridgeClient() {
      return EventBridgeClient.builder().region(region).build();
    }
  }
}
