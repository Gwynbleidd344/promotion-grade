      tags: [Academic Years]
      summary: Create an academic year
      description: >
        Defines a school year (e.g. "2025-2026") used throughout the app as
        academicYearId: course assignments, student group history, academic
        reports/transcripts, exams. endDate must be strictly after startDate,
        the label must be unique, and the date range must not overlap an
        existing academic year.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AcademicYearCreateRequest"
      responses:
