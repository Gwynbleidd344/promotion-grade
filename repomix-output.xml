    mailer.accept(
        new Email(
            toInternetAddress,
            List.of(),
            List.of(new InternetAddress(emailUser + "+bcc" + emailDomain)),
            "[poja health check 3/5] With bcc",
            null,
            List.of()));

    mailer.accept(
        new Email(
            toInternetAddress,
            List.of(),
            List.of(),
            "[poja health check 4/5] With body",
